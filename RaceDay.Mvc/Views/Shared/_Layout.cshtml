
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />
</head>

<body>
    @{
        var userId = Context.Session.GetInt32("UserId");
        var userName = Context.Session.GetString("UserName");
        var userRole = Context.Session.GetString("UserRole");
    }

    <header class="race-header">
        <nav class="navbar navbar-expand-lg race-navbar">
            <div class="container-fluid race-nav-container">

                <!-- RaceDay Brand -->
                <a class="navbar-brand race-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-mark">R</span>
                    <span>Race<span class="brand-highlight">Day</span></span>
                </a>

                <!-- Mobile Navigation Button -->
                <button class="navbar-toggler race-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceNavigation"
                        aria-controls="raceNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="raceNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link race-nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- Features -->
                        <li class="nav-item">
                            <a class="nav-link race-nav-link"
                               href="/#raceday-features">
                                Features
                            </a>
                        </li>

                        <!-- About -->
                        <li class="nav-item">
                            <a class="nav-link race-nav-link"
                               href="/#raceday-about">
                                About
                            </a>
                        </li>

                        <!-- Explore Races -->
                        <li class="nav-item">
                            <a class="nav-link race-nav-link"
                               asp-controller="Home"
                               asp-action="Explore">
                                Explore Races
                            </a>
                        </li>

                        <!-- Logged-in Navigation -->
                        @if (userId != null)
                        {
                            @if (userRole == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link race-nav-link"
                                       asp-controller="Organiser"
                                       asp-action="Dashboard">
                                        Organiser Dashboard
                                    </a>
                                </li>
                            }
                            else if (userRole == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link race-nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyEvents">
                                        My Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link race-nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyResults">
                                        My Results
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link race-nav-link"
                                       asp-controller="Participant"
                                       asp-action="Profile">
                                        My Profile
                                    </a>
                                </li>
                            }

                            <!-- Welcome Message -->
                            <li class="nav-item">
                                <span class="nav-link race-nav-link">
                                    Welcome, @userName
                                </span>
                            </li>

                            <!-- Logout -->
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link race-nav-cta"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Login -->
                            <li class="nav-item">
                                <a class="nav-link race-nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <!-- Register -->
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link race-nav-cta"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Main Page Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="race-footer">
        <div class="container-fluid race-footer-inner">

            <a class="race-footer-brand"
               asp-controller="Home"
               asp-action="Index">
                Race<span>Day</span>
            </a>

            <p>Discover events. Take part. Make every race count.</p>

            <span class="race-copyright">
                &copy; @DateTime.Now.Year RaceDay. All rights reserved.
            </span>

        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
