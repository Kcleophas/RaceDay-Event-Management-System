@model List<RaceDay.Mvc.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<section class="explore-header">
    <span class="hero-eyebrow">RACEDAY MANAGEMENT</span>
    <h1>Manage Race Events</h1>
    <p>Create, view, update and delete race events.</p>
</section>

<section class="explore-events">

    <div class="section-heading">
        <h2>All Race Events</h2>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create New Event
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ApiError != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ApiError
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <p>No race events are currently available.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Event ID</th>
                        <th>Event Name</th>
                        <th>Event Date</th>
                        <th>Distance (KM)</th>
                        <th>Event Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>@raceEvent.EventID</td>
                            <td>@raceEvent.EventName</td>
                            <td>@raceEvent.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@raceEvent.DistanceKm km</td>
                            <td>@raceEvent.EventType</td>
                            <td>
                                <a asp-action="EditEvent"
                                   asp-route-id="@raceEvent.EventID"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="DeleteEvent"
                                      asp-route-id="@raceEvent.EventID"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</section>