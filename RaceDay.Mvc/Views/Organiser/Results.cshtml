
@model List<RaceDay.Mvc.Models.ResultDetailsViewModel>

@{
    ViewData["Title"] = "Manage Results";
}

<section class="explore-header">
    <span class="hero-eyebrow">RACEDAY MANAGEMENT</span>
    <h1>Race Results</h1>
    <p>View participant finishing times and race positions.</p>
</section>

<section class="explore-events">

    @if (ViewBag.ApiError != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ApiError
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="section-heading">
        <h2>All Race Results</h2>

        <div>
            <span class="badge bg-primary me-2">
                Total Results: @(Model?.Count ?? 0)
            </span>

            <a asp-controller="Organiser"
               asp-action="CreateResult"
               class="btn btn-primary">
                + Add Result
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No race results have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Participant</th>
                        <th>Email Address</th>
                        <th>Race Event</th>
                        <th>Finishing Time</th>
                        <th>Position</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ResultID</td>
                            <td>@result.ParticipantName</td>
                            <td>@result.ParticipantEmail</td>
                            <td>@result.EventName</td>
                            <td>@result.FinishTime</td>
                            <td>
                                @if (result.Position == 1)
                                {
                                    <span class="badge bg-warning text-dark">
                                        1st Place
                                    </span>
                                }
                                else if (result.Position == 2)
                                {
                                    <span class="badge bg-secondary">
                                        2nd Place
                                    </span>
                                }
                                else if (result.Position == 3)
                                {
                                    <span class="badge bg-info text-dark">
                                        3rd Place
                                    </span>
                                }
                                else
                                {
                                    @result.Position
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</section>
