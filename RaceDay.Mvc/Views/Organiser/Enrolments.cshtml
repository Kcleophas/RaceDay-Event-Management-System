
@model List<RaceDay.Mvc.Models.EnrolmentDetailsViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<section class="explore-header">
    <span class="hero-eyebrow">RACEDAY MANAGEMENT</span>
    <h1>Participant Enrolments</h1>
    <p>View participants and the races they have registered for.</p>
</section>

<section class="explore-events">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ApiError != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ApiError
        </div>
    }

    <div class="section-heading">
        <h2>All Enrolments</h2>
        <span class="badge bg-primary">
            Total: @(Model?.Count ?? 0)
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participant enrolments are currently available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Participant</th>
                        <th>Email Address</th>
                        <th>Race Event</th>
                        <th>Category</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EnrolmentID</td>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.ParticipantEmail</td>
                            <td>@enrolment.EventName</td>
                            <td>@enrolment.CategoryName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</section>
